{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-records.schema.json",
  "title": "Schema-v2 bodies (authored, not validated)",
  "description": "UTF-8 byte bounds, hashes, authority, ancestry, strict duplicate-key parsing and dependency/lifecycle semantics are enforced by Go and cannot be proved by this schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/Project"
    },
    {
      "$ref": "#/$defs/SessionManifest"
    },
    {
      "$ref": "#/$defs/SessionChunk"
    },
    {
      "$ref": "#/$defs/Summary"
    },
    {
      "$ref": "#/$defs/Insight"
    },
    {
      "$ref": "#/$defs/Knowledge"
    },
    {
      "$ref": "#/$defs/Projection"
    },
    {
      "$ref": "#/$defs/BridgeGrant"
    },
    {
      "$ref": "#/$defs/AggregationGrant"
    },
    {
      "$ref": "#/$defs/Job"
    },
    {
      "$ref": "#/$defs/Suppression"
    }
  ],
  "$defs": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 16,
          "minItems": 0
        }
      }
    },
    "Origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_store",
        "harness",
        "native_session_id"
      ],
      "properties": {
        "source_store": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "maxLength": 128,
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "native_session_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "native_id",
        "strength"
      ],
      "properties": {
        "harness": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "native_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "strength": {
          "const": "strong"
        }
      }
    },
    "SessionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "origin",
        "relation"
      ],
      "properties": {
        "session": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "minLength": 8,
              "maxLength": 128
            },
            {
              "const": ""
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "relation": {
          "enum": [
            "fork",
            "subagent",
            "continuation",
            "view_of",
            "clear_successor"
          ]
        }
      }
    },
    "CapturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "redaction",
        "tool_detail",
        "attachments"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "redaction": {
          "const": "redact/v1"
        },
        "tool_detail": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "metadata",
            "full"
          ]
        },
        "attachments": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "count"
      ],
      "properties": {
        "from": {
          "type": "string",
          "maxLength": 256
        },
        "to": {
          "type": "string",
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "tool_body_excluded",
            "attachment_excluded",
            "spilled_tool_output",
            "ambiguous_project",
            "excluded_project",
            "too_large",
            "unsupported_type",
            "paused_skipped",
            "source_lost",
            "duplicate_view",
            "inherited_row",
            "session_excluded",
            "transport_truncated",
            "backfill_time_excluded",
            "future_baseline_excluded",
            "rewrite_unresolved",
            "derive_inputs_incomplete"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SessionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_key",
        "project_id",
        "origin",
        "adapter",
        "policy",
        "state",
        "chunk_high"
      ],
      "properties": {
        "session_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "adapter": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "harness_version": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "branch": {
          "type": "string",
          "maxLength": 256
        },
        "parent": {
          "$ref": "#/$defs/SessionLink"
        },
        "links": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/SessionLink"
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "policy": {
          "$ref": "#/$defs/CapturePolicy"
        },
        "state": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "open",
            "idle",
            "closed",
            "unknown"
          ]
        },
        "chunk_high": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "integer",
            "minimum": -1
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Gap"
          }
        },
        "continues": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "minLength": 8,
              "maxLength": 128
            },
            {
              "const": ""
            }
          ]
        }
      }
    },
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "index",
        "count"
      ],
      "properties": {
        "group": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "native_id": {
          "type": "string",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "user",
            "assistant",
            "system",
            "tool"
          ]
        },
        "type": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "reasoning",
            "compaction",
            "correction",
            "meta"
          ]
        },
        "time": {
          "type": "string",
          "maxLength": 40
        },
        "parent": {
          "type": "string",
          "maxLength": 256
        },
        "turn": {
          "type": "string",
          "maxLength": 256
        },
        "tool_name": {
          "type": "string",
          "maxLength": 256
        },
        "tool_status": {
          "type": "string",
          "maxLength": 128
        },
        "tool_call_id": {
          "type": "string",
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "maxLength": 524288
        },
        "part": {
          "$ref": "#/$defs/Part"
        },
        "view_of": {
          "type": "string",
          "maxLength": 256
        },
        "retracts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "maxItems": 4096,
          "minItems": 0
        },
        "origin": {
          "enum": [
            "",
            "capsule_recall"
          ]
        },
        "sidechain": {
          "type": "boolean"
        }
      }
    },
    "Omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "bytes"
      ],
      "properties": {
        "event": {
          "type": "string",
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "tool_body_excluded",
            "attachment_excluded",
            "spilled_tool_output",
            "ambiguous_project",
            "excluded_project",
            "too_large",
            "unsupported_type",
            "paused_skipped",
            "source_lost",
            "duplicate_view",
            "inherited_row",
            "session_excluded",
            "transport_truncated",
            "backfill_time_excluded",
            "future_baseline_excluded",
            "rewrite_unresolved",
            "derive_inputs_incomplete"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "offset",
        "length",
        "class"
      ],
      "properties": {
        "event": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "class": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      }
    },
    "SessionChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "branch",
        "seq",
        "generation",
        "events",
        "digest"
      ],
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "branch": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "prev": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "minLength": 8,
              "maxLength": 128
            },
            {
              "const": ""
            }
          ]
        },
        "generation": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "events": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/Event"
          },
          "minItems": 1
        },
        "omissions": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/Omission"
          }
        },
        "redactions": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/Redaction"
          }
        },
        "digest": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "revision",
        "kind"
      ],
      "properties": {
        "record": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "project",
            "session_manifest",
            "session_chunk",
            "summary",
            "insight",
            "knowledge",
            "projection",
            "bridge_grant",
            "aggregation_grant",
            "job",
            "suppression"
          ]
        },
        "event_from": {
          "type": "string",
          "maxLength": 256
        },
        "event_to": {
          "type": "string",
          "maxLength": 256
        }
      },
      "dependentRequired": {
        "event_from": [
          "event_to"
        ],
        "event_to": [
          "event_from"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "event_from"
            ],
            "properties": {
              "event_from": {
                "minLength": 1
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "session_chunk"
              },
              "event_to": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt_version",
        "policy_version",
        "device",
        "job_key"
      ],
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "device": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "job_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "goal",
            "work",
            "claimed_outcome",
            "evidenced_outcome",
            "decision",
            "open_question",
            "lesson",
            "contradiction"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 16384
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "open_question"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "subject",
        "findings",
        "sources",
        "primary",
        "source_heads",
        "complete",
        "generator",
        "influence",
        "input_fingerprint"
      ],
      "properties": {
        "level": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "window",
            "session",
            "project_day",
            "personal_week"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "period_start": {
          "type": "string",
          "maxLength": 40
        },
        "period_end": {
          "type": "string",
          "maxLength": 40
        },
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 16384
        },
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 16384
        },
        "source_heads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 16384
        },
        "gaps": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Gap"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "generator": {
          "$ref": "#/$defs/Generator"
        },
        "influence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 16384
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "Insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "category",
        "assertion",
        "project_id",
        "evidence",
        "basis",
        "verification",
        "review",
        "candidate_key"
      ],
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "memory",
            "decision"
          ]
        },
        "category": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "fact",
            "preference",
            "constraint",
            "lesson",
            "choice",
            "idea",
            "rejected_alternative"
          ]
        },
        "assertion": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 16384
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 16384
        },
        "basis": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "decision_state": {
          "enum": [
            "",
            "proposed",
            "accepted",
            "superseded",
            "rejected"
          ]
        },
        "verification": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "none",
            "claimed",
            "evidenced"
          ]
        },
        "review": {
          "type": "string",
          "maxLength": 1024,
          "enum": [
            "candidate",
            "accepted",
            "rejected",
            "edited"
          ]
        },
        "auto_accepted": {
          "type": "boolean"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "minLength": 8,
              "maxLength": 128
            },
            {
              "const": ""
            }
          ]
        },
        "candidate_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,128}$",
            "minLength": 8,
            "maxLength": 128
          },
          "maxItems": 128,
          "minItems": 0
        },
        "generator": {
          "$ref": "#/$defs/Generator"
        },
        "influence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 16384
        },
        "owner_proof": {
          "$ref": "#/$defs/OwnerProof"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "required": [
              "owner_proof",
              "reviewer"
            ],
            "properties": {
              "basis": {
                "const": "explicit"
              },
              "review": {
                "enum": [
                  "accepted",
                  "edited"
                ]
              },
              "reviewer": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,128}$",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "not": {
              "required": [
                "generator"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "owner_proof"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "maxItems": 0
              },
              "contradictions": {
                "maxItems": 0
              },
              "influence": {
