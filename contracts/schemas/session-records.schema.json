          "type": "boolean",
          "description": "Opaque authenticated cleanup marker; no assertion/evidence/private revision IDs. Root status grants no authority."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "owner_withdrawn"
            ],
            "properties": {
              "owner_withdrawn": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "withdrawn"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "withdrawal_marker"
            ],
            "properties": {
              "withdrawal_marker": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "hidden",
                  "withdrawn"
                ]
