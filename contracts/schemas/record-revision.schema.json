{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-revision.schema.json",
  "title": "Decrypted revision (authored, not validated)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vault_id",
    "scope_id",
    "record_id",
    "revision_id",
    "operation_id",
    "author_device_id",
    "schema_version",
    "kind",
    "parents",
    "operation",
    "created_at",
    "tags",
    "provenance"
  ],
  "properties": {
    "vault_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "author_device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "type": "string"
    },
    "parents": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,128}$"
      }
    },
    "operation": {
      "enum": [
        "put",
        "delete",
        "restore",
        "resolve"
      ]
    },
    "restores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,128}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_ref"
      ],
      "properties": {
        "source_kind": {
          "type": "string"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "harness": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "body": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "enum": [
            "memory",
            "skill"
          ]
        },
        "provenance": {
          "properties": {
            "source_kind": {
              "enum": [
                "manual",
                "harness",
                "git",
                "import"
              ]
            }
          }
        }
      },
      "not": {
        "required": [
          "body"
        ]
      }
    },
    {
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "enum": [
            "project",
            "session_manifest",
            "session_chunk",
            "summary",
            "insight",
            "knowledge",
            "projection",
            "bridge_grant",
            "aggregation_grant",
            "job",
            "suppression"
          ]
        },
        "provenance": {
          "properties": {
            "source_kind": {
              "enum": [
                "capture",
                "derived",
                "projection",
                "manual",
                "import"
              ]
            }
          }
        }
      },
      "not": {
        "required": [
          "payload"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "project"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Project"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "session_manifest"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/SessionManifest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "session_chunk"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/SessionChunk"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "summary"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Summary"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "insight"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Insight"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "knowledge"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Knowledge"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "projection"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Projection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bridge_grant"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/BridgeGrant"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "aggregation_grant"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/AggregationGrant"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "job"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Job"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "suppression"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "session-records.schema.json#/$defs/Suppression"
              }
            }
          }
        }
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "body"
              ]
            }
          ]
        }
      },
      "else": {
        "oneOf": [
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "body"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "restore"
          }
        }
      },
      "then": {
        "required": [
          "restores"
        ],
        "properties": {
          "parents": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "restores"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "resolve"
          }
        }
      },
      "then": {
        "properties": {
          "parents": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
