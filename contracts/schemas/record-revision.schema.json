{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-revision.schema.json",
  "title": "Draft decrypted agent-memory record revision",
  "description": "Planning schema only. Does not define signing bytes, encryption, or transport.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "vault_id", "scope_id", "record_id", "kind",
    "revision_id", "parents", "operation_id", "operation",
    "author_device_id", "created_at", "provenance", "tags"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "vault_id": { "$ref": "#/$defs/id" },
    "scope_id": { "$ref": "#/$defs/id" },
    "record_id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["memory", "skill", "summary"] },
    "revision_id": { "$ref": "#/$defs/id" },
    "parents": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true,
      "maxItems": 128
    },
    "operation_id": { "$ref": "#/$defs/id" },
    "operation": { "enum": ["put", "delete", "restore", "resolve"] },
    "restores": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "author_device_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref"],
      "properties": {
        "source_kind": { "enum": ["manual", "harness", "git", "summary", "import"] },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "harness": { "type": "string", "maxLength": 128 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "uniqueItems": true,
      "maxItems": 64
    },
    "payload": {
      "type": "object",
      "description": "Kind-specific encrypted content; non-summary payload shape remains provisional.",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 1048576 },
        "source_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRevision" },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        },
        "coverage": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version", "model"],
          "properties": {
            "tool": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "model": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "delete" } } },
      "then": { "not": { "required": ["payload"] } },
      "else": { "required": ["payload"] }
    },
    {
      "if": { "properties": { "operation": { "const": "restore" } } },
      "then": { "required": ["restores"], "properties": { "parents": { "minItems": 1 } } },
      "else": { "not": { "required": ["restores"] } }
    },
    {
      "if": { "properties": { "operation": { "const": "resolve" } } },
      "then": { "properties": { "parents": { "minItems": 2 } } }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "summary" },
          "operation": { "enum": ["put", "restore", "resolve"] }
        }
      },
      "then": {
        "properties": {
          "payload": { "required": ["source_revisions", "coverage", "generator"] }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision_id"],
      "properties": {
        "record_id": { "$ref": "#/$defs/id" },
        "revision_id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
